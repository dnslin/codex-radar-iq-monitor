{
  "manifest_version": 3,
  "name": "Codex Radar IQ Monitor",
  "short_name": "Radar IQ",
  "version": "0.2.0",
  "description": "后台汇总 Codex Radar 五个模型各思考等级的 IQ，并在分数变化时提醒。",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://api.codexradar.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Codex Radar IQ",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
